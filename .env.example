POSTGRES_DB=snippycode
POSTGRES_USER=snippycode
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_PORT=5432

SNIPPYCODE_PORT=5000
SNIPPYCODE_IMAGE=ghcr.io/nerdy-technician/snippycode:latest
SESSION_SECRET=replace-with-a-long-random-secret
# Encrypts secret variables. Set it once and keep it: if it changes, stored
# secrets can no longer be read. Required in production (the server will not
# start without it). Generate with: openssl rand -hex 32
# Upgrading from a release that fell back to SESSION_SECRET: set it to your
# current SESSION_SECRET value so existing secrets stay readable.
VARIABLES_SECRET_KEY=

GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_BRANCH=main
SNIPPET_RUN_ENABLED=false
SNIPPET_RUN_TIMEOUT_MS=15000
# Public URL for share links and the PowerShell one-liner, e.g. https://snippycode.example.com
PUBLIC_BASE_URL=
