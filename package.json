{
  "name": "snippycode",
  "version": "1.2.1",
  "description": "Private self-hosted snippet manager with auth, raw links, GitHub sync, and PostgreSQL.",
  "main": "build/server.js",
  "scripts": {
    "init:client": "npm install --prefix=client",
    "init:server": "npm install",
    "init": "npm i && cd client && npm i",
    "dev:client": "DANGEROUSLY_DISABLE_HOST_CHECK=true HOST=0.0.0.0 PORT=3000 npm start --prefix=client",
    "dev:server": "NODE_ENV=development PORT=5000 nodemon",
    "dev": "npm-run-all -n --parallel dev:**",
    "build:client": "npm run build --prefix=client",
    "build:public": "rm -rf public && mkdir -p public && cp -R client/build/. public/",
    "build:clear": "rm -rf build",
    "build:tsc": "tsc",
    "build": "npm-run-all -n build:clear build:tsc build:client build:public",
    "lint": "npm-run-all -n lint:server lint:client",
    "lint:server": "eslint src test",
    "lint:client": "npm run lint --prefix=client",
    "typecheck": "npm-run-all -n typecheck:server typecheck:client",
    "typecheck:server": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "test": "npm-run-all -n test:server test:client",
    "test:server": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test '.test-build/test/**/*.test.js'",
    "test:client": "npm test --prefix=client -- --watchAll=false",
    "docker:build": "docker build -t snippycode .",
    "docker:up": "docker compose up -d --build"
  },
  "bin": {
    "snippycode": "build/cli.js"
  },
  "keywords": [
    "snippets",
    "self-hosted",
    "postgres",
    "github-sync"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/validator": "^13.6.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "~4.9.5",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@types/umzug": "^2.3.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "openid-client": "^5.7.1",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "umzug": "^2.3.0"
  }
}
